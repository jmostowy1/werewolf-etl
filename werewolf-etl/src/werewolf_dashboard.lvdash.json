    {
      "name": "96e65a6f",
      "displayName": "player_actions",
      "queryLines": [
        "SELECT\r\n",
        "    p.episode_id,\r\n",
        "    a.day,\r\n",
        "    a.phase,\r\n",
        "    a.step_index,\r\n",
        "    a.seat_index,\r\n",
        "    p.player_id,\r\n",
        "    p.model_name,\r\n",
        "    p.role,\r\n",
        "    p.team,\r\n",
        "    a.action_type,\r\n",
        "    a.target_id,\r\n",
        "    a.message,\r\n",
        "    a.reasoning,\r\n",
        "    a.perceived_threat_level,\r\n",
        "    CASE WHEN a.perceived_threat_level = 'SAFE' THEN 0\r\n",
        "        WHEN a.perceived_threat_level = 'UNEASY' THEN 1\r\n",
        "        ELSE 2\r\n",
        "    END AS perceived_threat_level_int,\r\n",
        "    a.prompt_tokens,\r\n",
        "    a.completion_tokens,\r\n",
        "    a.reported_cost\r\n",
        "FROM silver.players p\r\n",
        "INNER JOIN silver.actions a\r\n",
        "ON p.episode_id = a.episode_id AND p.player_id = a.actor_id"
      ]
    }
  ],
