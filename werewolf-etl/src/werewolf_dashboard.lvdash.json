    {
      "name": "ed810a81",
      "displayName": "players",
      "config": {
        "version": "1.1",
        "source": "workspace.silver.players",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "surviving_win_count",
            "expr": "SUM(CASE WHEN is_alive_winner = TRUE THEN 1 ELSE 0 END)",
            "displayName": "Surviving Win Count"
          },
          {
            "name": "surviving_win_rate",
            "expr": "MEASURE(surviving_win_count)/COUNT(*)",
            "displayName": "Surviving Win Rate"
          }
        ]
      }
    },
